    }
  },
  "scripts": {
    "test": "php php/tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=vlr-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-vlr",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=vlr-php-api-docs"
  }
}
