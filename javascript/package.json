{
  "name": "@crawlora-org/vlr",
  "version": "0.1.0",
  "description": "Crawlora VLR.gg API client with 23 endpoints for Valorant matches, events, results, rankings, statistics, news, and forum data",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=vlr-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-vlr/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "vlr", "vlr-gg", "vlr-api", "vlr-gg-api", "vlr-scraper", "vlr-gg-scraper", "vlr-data", "vlr-gg-data", "vlr-valorant-matches", "vlr-events", "vlr-results", "vlr-rankings", "vlr-statistics", "vlr-news", "vlr-forum-data"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-vlr",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
